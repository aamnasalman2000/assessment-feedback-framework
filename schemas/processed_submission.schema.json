{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Processed Student Submission",
  "description": "A structured representation of a student submission produced by the preprocessing pipeline.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "processed_submission_id",
    "source_submission_id",
    "student_id",
    "assessment_id",
    "artifacts"
  ],

  "properties": {

    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Version of the processed submission data structure."
    },

    "processed_submission_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this processed submission."
    },

    "source_submission_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the corresponding raw submission."
    },

    "student_id": {
      "type": "string",
      "minLength": 1,
      "description": "Pseudonymous identifier for the student."
    },

    "assessment_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier matching the relevant assessment specification."
    },

    "processing_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Version of the preprocessing pipeline used."
    },

    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/processedArtifact"
      }
    },

    "cross_artifact_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/crossArtifactLink"
      },
      "description": "Optional relationships identified between content in different artifacts."
    }
  },

  "$defs": {
    "processedArtifact": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "artifact_id",
        "artifact_type",
        "processing",
        "units"
      ],

      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier matching the corresponding raw artifact."
        },

        "artifact_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Artifact role, such as lean_source, prolog_source, owl_ontology, or ontology_report."
        },

        "processing": {
          "$ref": "#/$defs/processingRecord"
        },

        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit"
          },
          "description": "Meaningful content units extracted from the artifact."
        }
      }
    },

    "processingRecord": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "status",
        "extraction_mode",
        "checks",
        "diagnostics"
      ],

      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "partial",
            "failed"
          ],
          "description": "Overall preprocessing status for the artifact."
        },

        "extraction_mode": {
          "type": "string",
          "enum": [
            "parser",
            "textual",
            "hybrid",
            "manual"
          ],
          "description": "Primary method used to extract structured content."
        },

        "detected_content_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Content type inferred by preprocessing when it differs from or adds detail to artifact_type."
        },

        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolRecord"
          }
        },

        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/processingCheck"
          }
        },

        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },

    "toolRecord": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "name"
      ],

      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },

        "version": {
          "type": [
            "string",
            "null"
          ]
        },

        "purpose": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "processingCheck": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "check_type",
        "status"
      ],

      "properties": {
        "check_type": {
          "type": "string",
          "minLength": 1,
          "description": "Type of technical check, such as lean_compile, prolog_parse, owl_parse, or text_extraction."
        },

        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_run",
            "not_applicable"
          ]
        },

        "tool": {
          "type": [
            "string",
            "null"
          ]
        },

        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "diagnostic": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "severity",
        "message"
      ],

      "properties": {
        "diagnostic_id": {
          "type": [
            "string",
            "null"
          ]
        },

        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },

        "diagnostic_type": {
          "type": [
            "string",
            "null"
          ]
        },

        "message": {
          "type": "string",
          "minLength": 1
        },

        "source_range": {
          "$ref": "#/$defs/sourceRange"
        },

        "related_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },

    "unit": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "unit_id",
        "unit_type",
        "content_blocks"
      ],

      "properties": {
        "unit_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier unique within the processed submission."
        },

        "unit_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Semantic role of the extracted unit."
        },

        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable name, heading, predicate name, theorem name, or entity label."
        },

        "task_mapping": {
          "$ref": "#/$defs/taskMapping"
        },

        "attempt": {
          "$ref": "#/$defs/attemptRecord"
        },

        "source_range": {
          "$ref": "#/$defs/sourceRange"
        },

        "parent_unit_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Identifier of a containing or logically parent unit."
        },

        "context_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Other extracted units required to interpret this unit."
        },

        "content_blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        },

        "structured_data": {
          "type": [
            "object",
            "null"
          ],
          "description": "Optional machine-readable representation specific to the unit type.",
          "additionalProperties": true
        },

        "extraction_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence in the extraction or classification of this unit."
        }
      }
    },

    "taskMapping": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "source"
      ],

      "properties": {
        "part_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },

        "task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },

        "source": {
          "type": "string",
          "enum": [
            "declared",
            "inferred",
            "mixed"
          ]
        },

        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },

        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },

      "anyOf": [
        {
          "required": [
            "part_ids"
          ]
        },
        {
          "required": [
            "task_ids"
          ]
        }
      ]
    },

    "attemptRecord": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "attempt_index"
      ],

      "properties": {
        "attempt_index": {
          "type": "integer",
          "minimum": 1
        },

        "attempt_group_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Groups multiple attempts that answer the same task."
        },

        "declared_as_alternative": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the student explicitly presented this as another or alternative solution."
        }
      }
    },

    "contentBlock": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "block_type",
        "content"
      ],

      "properties": {
        "block_id": {
          "type": [
            "string",
            "null"
          ]
        },

        "block_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Type of content, such as formal_statement, proof_body, explanation, formula, prose, code, heading, or comment."
        },

        "content": {
          "type": "string"
        },

        "language": {
          "type": [
            "string",
            "null"
          ],
          "description": "Language or notation, such as lean, prolog, description_logic, xml, or en."
        },

        "source_range": {
          "$ref": "#/$defs/sourceRange"
        }
      }
    },

    "sourceRange": {
        "type": "object",
        "additionalProperties": false,

        "required": [
            "start_line",
            "end_line"
        ],

        "properties": {
            "start_line": {
            "type": "integer",
            "minimum": 1
            },

            "end_line": {
            "type": "integer",
            "minimum": 1
            },

            "start_column": {
            "type": "integer",
            "minimum": 1
            },

            "end_column": {
            "type": "integer",
            "minimum": 1
            }
        }
    },

    "crossArtifactLink": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "link_id",
        "link_type",
        "source_artifact_id",
        "target_artifact_id"
      ],

      "properties": {
        "link_id": {
          "type": "string",
          "minLength": 1
        },

        "link_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },

        "source_artifact_id": {
          "type": "string",
          "minLength": 1
        },

        "source_unit_id": {
          "type": [
            "string",
            "null"
          ]
        },

        "target_artifact_id": {
          "type": "string",
          "minLength": 1
        },

        "target_unit_id": {
          "type": [
            "string",
            "null"
          ]
        },

        "description": {
          "type": [
            "string",
            "null"
          ]
        },

        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}