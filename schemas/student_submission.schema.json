{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/student_submission.schema.json",
  "title": "Student Assessment Submission",
  "description": "A normalised representation of a student's assessment submission before task-level preprocessing and evaluation.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "submission_id",
    "student_id",
    "assessment_id",
    "artifacts"
  ],


  "properties": {
    
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Version of the processed submission data structure."
    },

    "submission_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this submission."
    },

    "student_id": {
      "type": "string",
      "minLength": 1,
      "description": "Pseudonymous identifier for the student."
    },

    "assessment_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier matching the relevant assessment specification."
    },

    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },

  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "artifact_id",
        "artifact_type",
        "source",
        "content"
      ],

      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier unique within this submission."
        },

        "artifact_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "The assessment role of the artifact, such as lean_source, owl_ontology, ontology_report, or prolog_source."
        },

        "source": {
          "$ref": "#/$defs/source"
        },

        "associations": {
          "$ref": "#/$defs/associations"
        },

        "content": {
          "$ref": "#/$defs/content"
        }
      }
    },

    "source": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "filename",
        "format"
      ],

      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "description": "Original submitted filename."
        },

        "format": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9.+_-]*$",
          "description": "File format or extension without a leading dot, such as lean, pl, txt, owx, or pdf."
        },

        "media_type": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-zA-Z0-9!#$&^_.+-]+/[a-zA-Z0-9!#$&^_.+-]+$",
          "description": "MIME media type when known."
        },

        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "Relative or internal path to the original submitted file when retained by the pipeline."
        }
      }
    },

    "associations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional routing metadata linking an artifact to assessment parts or tasks.",

      "required": [
        "source"
      ],

      "properties": {
        "part_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },

        "task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },

        "source": {
          "type": "string",
          "enum": [
            "declared",
            "inferred",
            "mixed"
          ],
          "description": "Whether the associations came from explicit file organisation, preprocessing, or both."
        }
      },

      "anyOf": [
        {
          "required": [
            "part_ids"
          ]
        },
        {
          "required": [
            "task_ids"
          ]
        }
      ]
    },

    "content": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "raw_content"
      ],

      "properties": {
        "raw_content": {
          "type": "string",
          "description": "Textual content of the artifact before task-level parsing or semantic restructuring."
        },

        "content_encoding": {
          "type": "string",
          "default": "utf-8",
          "description": "Character encoding used for the textual content."
        }
      }
    }
  }
}