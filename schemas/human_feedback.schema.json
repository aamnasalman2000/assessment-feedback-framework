{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Feedback",
  "description": "Schema for normalised human marker feedback associated with a student assessment submission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "human_feedback_id",
    "submission_id",
    "student_id",
    "assessment_id",
    "source",
    "observations",
    "feedback_sections",
    "overall_feedback"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of the human feedback schema.",
      "minLength": 1
    },
    "human_feedback_id": {
      "type": "string",
      "description": "Unique identifier for this human feedback record.",
      "minLength": 1
    },
    "submission_id": {
      "type": "string",
      "description": "Identifier of the student submission to which the feedback relates.",
      "minLength": 1
    },
    "student_id": {
      "type": "string",
      "description": "Identifier of the student associated with the feedback.",
      "minLength": 1
    },
    "assessment_id": {
      "type": "string",
      "description": "Identifier of the assessment specification associated with the feedback.",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/sourceRecord"
    },
    "marks": {
      "$ref": "#/$defs/marksRecord"
    },
    "observations": {
      "type": "array",
      "description": "Normalised feedback observations extracted from the original marker feedback.",
      "items": {
        "$ref": "#/$defs/humanObservation"
      }
    },
    "feedback_sections": {
      "type": "array",
      "description": "Sections representing the grouping and presentation of the original marker feedback.",
      "items": {
        "$ref": "#/$defs/feedbackSection"
      }
    },
    "overall_feedback": {
      "$ref": "#/$defs/overallFeedback"
    }
  },
  "$defs": {
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "normalisation_method"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "description": "Original source from which the human feedback was obtained.",
          "enum": [
            "spreadsheet",
            "document",
            "learning_management_system",
            "email",
            "plain_text",
            "manual_entry",
            "other"
          ]
        },
        "source_reference": {
          "type": "string",
          "description": "Optional identifier, filename or record reference for the original feedback source.",
          "minLength": 1
        },
        "marker_id": {
          "type": "string",
          "description": "Optional pseudonymised identifier for the marker.",
          "minLength": 1
        },
        "normalisation_method": {
          "type": "string",
          "description": "How the original feedback was converted into the structured representation.",
          "enum": [
            "manual",
            "automatic",
            "automatic_reviewed",
            "mixed"
          ]
        },
        "normalised_by": {
          "type": "string",
          "description": "Optional identifier for the person or system responsible for normalisation.",
          "minLength": 1
        },
        "original_feedback_text": {
          "type": "string",
          "description": "Original unmodified marker feedback text.",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "description": "Optional notes about ambiguity, formatting or decisions made during normalisation.",
          "minLength": 1
        }
      }
    },
    "marksRecord": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional record of marks supplied by the human marker. Marks are retained for context but are not part of the primary feedback comparison.",
      "properties": {
        "total_awarded": {
          "type": "number",
          "minimum": 0
        },
        "total_available": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "breakdown": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/markEntry"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "total_awarded"
          ]
        },
        {
          "required": [
            "percentage"
          ]
        },
        {
          "required": [
            "breakdown"
          ]
        }
      ]
    },
    "markEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mark_entry_id",
        "label",
        "awarded"
      ],
      "properties": {
        "mark_entry_id": {
          "type": "string",
          "description": "Unique identifier for this mark entry.",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "description": "Human-readable label from the marking record.",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "enum": [
            "overall",
            "part",
            "task",
            "criterion",
            "other"
          ]
        },
        "part_ids": {
          "$ref": "#/$defs/idArray"
        },
        "task_ids": {
          "$ref": "#/$defs/idArray"
        },
        "requirement_ids": {
          "$ref": "#/$defs/idArray"
        },
        "awarded": {
          "type": "number",
          "minimum": 0
        },
        "available": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "humanObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "feedback_type",
        "scope",
        "text",
        "source_span"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "description": "Unique identifier for the normalised human feedback observation.",
          "minLength": 1
        },
        "feedback_type": {
          "type": "string",
          "description": "Communicative purpose of the human feedback observation.",
          "enum": [
            "strength",
            "error",
            "omission",
            "suggestion"
          ]
        },
        "scope": {
          "type": "string",
          "description": "Level of the assessment to which the observation applies.",
          "enum": [
            "overall",
            "part",
            "task",
            "task_group",
            "attempt"
          ]
        },
        "part_ids": {
          "$ref": "#/$defs/idArray"
        },
        "task_ids": {
          "$ref": "#/$defs/idArray"
        },
        "attempt_unit_ids": {
          "$ref": "#/$defs/idArray"
        },
        "requirement_ids": {
          "type": "array",
          "description": "Rubric requirements associated with the human observation when these can be mapped reliably.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "text": {
          "type": "string",
          "description": "Normalised wording of the human feedback observation.",
          "minLength": 1
        },
        "original_text": {
          "type": "string",
          "description": "Exact wording from the original marker feedback when it differs from the normalised text.",
          "minLength": 1
        },
        "source_span": {
          "$ref": "#/$defs/sourceSpan"
        },
        "mapping_confidence": {
          "type": "string",
          "description": "Confidence in the assigned task, part or rubric mappings.",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "annotation_notes": {
          "type": "string",
          "description": "Optional notes explaining interpretation or mapping decisions.",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "part"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "required": [
              "part_ids"
            ],
            "properties": {
              "part_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "enum": [
                  "task",
                  "task_group"
                ]
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "required": [
              "task_ids"
            ],
            "properties": {
              "task_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "attempt"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "required": [
              "attempt_unit_ids"
            ],
            "properties": {
              "attempt_unit_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "feedbackSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "scope",
        "summary",
        "observation_ids"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "description": "Unique identifier for this human feedback section.",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "description": "Optional human-readable section label.",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "description": "Assessment level represented by the section.",
          "enum": [
            "overall",
            "part",
            "task",
            "task_group"
          ]
        },
        "part_ids": {
          "$ref": "#/$defs/idArray"
        },
        "task_ids": {
          "$ref": "#/$defs/idArray"
        },
        "attempt_unit_ids": {
          "$ref": "#/$defs/idArray"
        },
        "summary": {
          "type": "string",
          "description": "Normalised student-facing summary for this feedback section.",
          "minLength": 1
        },
        "original_text": {
          "type": "string",
          "description": "Original marker paragraph or section from which the summary and observations were derived.",
          "minLength": 1
        },
        "observation_ids": {
          "type": "array",
          "description": "Human observations represented in this section.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "part"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "required": [
              "part_ids"
            ],
            "properties": {
              "part_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "enum": [
                  "task",
                  "task_group"
                ]
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "required": [
              "task_ids"
            ],
            "properties": {
              "task_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "overallFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "observation_ids"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "description": "Overall normalised summary of the human marker feedback.",
          "minLength": 1
        },
        "strengths_summary": {
          "type": "string",
          "description": "Optional synthesis of the main strengths identified by the marker.",
          "minLength": 1
        },
        "improvement_summary": {
          "type": "string",
          "description": "Optional synthesis of the main areas for improvement identified by the marker.",
          "minLength": 1
        },
        "original_text": {
          "type": "string",
          "description": "Original full marker feedback text.",
          "minLength": 1
        },
        "observation_ids": {
          "type": "array",
          "description": "Human observations reflected in the overall feedback.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "description": "Location of an observation within the original human feedback source.",
      "required": [
        "span_type"
      ],
      "properties": {
        "span_type": {
          "type": "string",
          "enum": [
            "character_range",
            "sentence",
            "paragraph",
            "cell",
            "section",
            "whole_feedback"
          ]
        },
        "start_character": {
          "type": "integer",
          "minimum": 0
        },
        "end_character": {
          "type": "integer",
          "minimum": 0
        },
        "sentence_index": {
          "type": "integer",
          "minimum": 0
        },
        "paragraph_index": {
          "type": "integer",
          "minimum": 0
        },
        "sheet_name": {
          "type": "string",
          "minLength": 1
        },
        "cell_reference": {
          "type": "string",
          "minLength": 1
        },
        "section_label": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "span_type": {
                "const": "character_range"
              }
            },
            "required": [
              "span_type"
            ]
          },
          "then": {
            "required": [
              "start_character",
              "end_character"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "span_type": {
                "const": "sentence"
              }
            },
            "required": [
              "span_type"
            ]
          },
          "then": {
            "required": [
              "sentence_index"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "span_type": {
                "const": "paragraph"
              }
            },
            "required": [
              "span_type"
            ]
          },
          "then": {
            "required": [
              "paragraph_index"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "span_type": {
                "const": "cell"
              }
            },
            "required": [
              "span_type"
            ]
          },
          "then": {
            "required": [
              "cell_reference"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "span_type": {
                "const": "section"
              }
            },
            "required": [
              "span_type"
            ]
          },
          "then": {
            "required": [
              "section_label"
            ]
          }
        }
      ]
    },
    "idArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}