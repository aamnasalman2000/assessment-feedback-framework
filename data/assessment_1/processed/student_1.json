            },
            {
              "block_id": "artifact_001_unit_002_proof",
              "block_type": "proof_body",
              "content": "by\n    rcases h with ⟨hbd, hand, haord, hb, hnc⟩\n    have hd := hbd hb\n    cases haord with\n    | inl ha => exact ⟨ha, hd⟩\n    | inr hd' => exact ⟨by_contradiction (λ hna => hnc ((hand hna).left)), hd'⟩",
              "language": "lean",
              "source_range": {
                "start_line": 29,
                "end_line": 34
              }
            },
            {
              "block_id": "artifact_001_unit_002_explanation",
              "block_type": "explanation",
              "content": "Explanation:\nFrom b and b → d we get d. Then from a ∨ d and ¬c, we infer a must be true via contradiction.",
              "language": "en",
              "source_range": {
                "start_line": 36,
