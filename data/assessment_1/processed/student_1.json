          "label": "ex3",
          "source_range": {
            "start_line": 110,
            "end_line": 118
          },
          "content_blocks": [
            {
              "block_id": "artifact_001_unit_014_statement",
              "block_type": "formal_statement",
              "content": "theorem ex3 : ∀ x y z, provable (conj x (conj y z)) → provable (conj (conj y x) z)",
              "language": "lean",
              "source_range": {
                "start_line": 110,
                "end_line": 110
              }
            },
            {
              "block_id": "artifact_001_unit_014_proof",
              "block_type": "proof_body",
              "content": "by\n    intros x y z h\n    have px : provable x := AxConjElimLeft x (conj y z) h\n    have pyz : provable (conj y z) := AxConjElimRight x (conj y z) h\n    have py : provable y := AxConjElimLeft y z pyz\n    have pz : provable z := AxConjElimRight y z pyz\n    have pxy : provable (conj y x) := AxConjIntro y x py px\n    exact AxConjIntro (conj y x) z pxy pz",
              "language": "lean",
              "source_range": {
                "start_line": 111,
                "end_line": 118
              }
            },
            {
              "block_id": "artifact_001_unit_014_explanation",
              "block_type": "explanation",
              "content": "Explanation for ex3:\nThis theorem restructures nested conjunctions:\nFrom provable (x ∧ (y ∧ z)), we extract:\n- provable x\n- provable y and z from the inner conjunction\n\nThen we reconstruct:\n- provable (y ∧ x)\n- followed by provable ((y ∧ x) ∧ z)\nThis shows how associativity of conjunction is preserved under provability.",
              "language": "en",
              "source_range": {
                "start_line": 150,
                "end_line": 159
              }
            }
