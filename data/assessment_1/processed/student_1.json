        {
          "unit_id": "artifact_001_unit_013",
          "unit_type": "lean_theorem",
          "label": "ex2",
          "source_range": {
            "start_line": 103,
            "end_line": 107
          },
          "content_blocks": [
            {
              "block_id": "artifact_001_unit_013_statement",
              "block_type": "formal_statement",
              "content": "theorem ex2 : ∀ x y, provable (conj x False) → provable y",
              "language": "lean",
              "source_range": {
                "start_line": 103,
                "end_line": 103
              }
            },
            {
              "block_id": "artifact_001_unit_013_proof",
              "block_type": "proof_body",
              "content": "by\n    intros x y h\n    have pf : provable False := AxConjElimRight x False h\n    exact False.elim (AxNotPrFalse pf)",
              "language": "lean",
              "source_range": {
                "start_line": 104,
                "end_line": 107
              }
            },
            {
              "block_id": "artifact_001_unit_013_explanation",
              "block_type": "explanation",
              "content": "Explanation for ex2:\nFrom a contradiction, anything follows (principle of explosion).\nIf conj x False is provable, we can extract provable False.\nFrom that, we can derive any provable y using False.elim and AxNotPrFalse.",
              "language": "en",
              "source_range": {
                "start_line": 143,
                "end_line": 146
