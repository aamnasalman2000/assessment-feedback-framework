            {
              "block_id": "artifact_001_unit_002_statement",
              "block_type": "formal_statement",
              "content": "example (a b c d : Prop)\n  (h : (b → d) ∧ (¬a → (c ∧ d)) ∧ (a ∨ d) ∧ b ∧ ¬c) : a ∧ d",
              "language": "lean",
